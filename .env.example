# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env`.

# --- Servidor ---
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
# URL pública canónica del servidor MCP (Alexa+ la usa como parámetro `resource`)
NEXUS_PUBLIC_URL=

# --- Autenticación (se usa desde NX-06 · Día 4) ---
AUTH_ISSUER_URL=
AUTH_REQUIRED_SCOPES=

# --- Auditoría (se usa desde NX-04 · Día 3) ---
AUDIT_FILE_PATH=data/audit.jsonl